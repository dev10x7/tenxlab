{
  "name": "tenxlab",
  "version": "0.1.0",
  "private": true,
  "description": "TenXLab — multi-tenant academic-integrated skilling platform",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test --test-reporter=spec \"deploy/**/*.test.mjs\"",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run build -w @tenxlab/contracts -w @tenxlab/runtime-policy -w @tenxlab/lab-provider && npm run typecheck --workspaces --if-present",
    "license:check": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
