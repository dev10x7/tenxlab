// TenXLab domain schema. System of record = PostgreSQL.
// Multi-tenancy: every tenant-scoped row carries tenantId; RLS policies are
// applied in a follow-up migration (see prisma/rls.sql).

generator client {
  provider      = "prisma-client-js"
  // "native" covers local/dev hosts; debian-openssl-3.0.x matches the
  // node:22-slim runtime so the container finds its query engine.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Tenancy

model Tenant {
  id                String   @id @default(uuid())
  name              String
  domain            String   @unique
  maxConcurrentLabs Int      @default(50)
  plan              String   @default("standard")
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  departments       Department[]
  users             Membership[]
  courses           Course[]
  batches           AcademicBatch[]
  projects          Project[]
  projectComponents ProjectComponent[]

  @@map("tenants")
}

model Department {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches AcademicBatch[]

  @@unique([tenantId, name])
  @@map("departments")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String
  createdAt DateTime @default(now())

  memberships Membership[]
  progress    LessonProgress[]
  attempts    Attempt[]
  sessions    LabSession[]
  snippets    CodeSnippet[]

  projectWorkspaces  ProjectWorkspace[]
  projectForks       ProjectFork[]
  projectSubmissions ProjectSubmission[]

  @@map("users")
}

model Membership {
  id       String @id @default(uuid())
  userId   String
  tenantId String
  role     String // student | instructor | college_admin | recruiter | platform_admin
  status   String @default("active")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, role])
  @@map("memberships")
}

model PartnerSsoReplay {
  jti       String   @id
  partnerId String
  seenAt    DateTime @default(now())

  @@index([seenAt])
  @@map("partner_sso_replays")
}

// ---------------------------------------------------------------- Learning

model AcademicBatch {
  id           String    @id @default(uuid())
  tenantId     String
  departmentId String?
  name         String
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department  Department?  @relation(fields: [departmentId], references: [id])
  enrollments Enrollment[]

  @@index([tenantId])
  @@map("academic_batches")
}

model Course {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  description String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modules     Module[]
  enrollments Enrollment[]

  @@index([tenantId])
  @@map("courses")
}

model Module {
  id       String @id @default(uuid())
  courseId String
  title    String
  position Int    @default(0)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id           String  @id @default(uuid())
  moduleId     String
  title        String
  type         String // video | text | pdf | interactive_lab
  position     Int     @default(0)
  // interactive_lab fields
  labProvider  String?
  exerciseSlug String?
  runtimeTier  String?
  maxScore     Int     @default(100)

  module   Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([moduleId])
  @@map("lessons")
}

model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  batchId   String?
  createdAt DateTime @default(now())

  course Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch  AcademicBatch? @relation(fields: [batchId], references: [id])

  @@unique([userId, courseId])
  @@map("enrollments")
}

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  status      String    @default("not_started") // not_started | in_progress | complete
  score       Int?
  attempts    Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// ---------------------------------------------------------------- Labs

model LabSession {
  id             String   @id @default(uuid())
  tenantId       String
  userId         String
  exerciseSlug   String
  tier           String
  status         String   @default("WARM") // WARM | ACTIVE | IDLE | TERMINATED
  ideUrl         String?
  kubelabRef     String?
  startedAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  ttlSeconds     Int      @default(1800)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([userId])
  @@map("lab_sessions")
}

// Sandboxes the warm-pool operator has booted and not yet claimed. A row is
// the pool's inventory of "already running, no student attached" capacity; the
// operator reconciles it toward the per-tier target and a launch claims one.
model WarmSandbox {
  id          String   @id @default(uuid())
  tier        String
  providerRef String
  createdAt   DateTime @default(now())

  @@index([tier])
  @@map("warm_sandboxes")
}

// ---------------------------------------------------------------- Editor

// Per-user saved code from the Editor surface. Scoped by userId: a snippet is
// private to its author and never shared across users or tenants.
model CodeSnippet {
  id        String   @id @default(uuid())
  userId    String
  language  String
  title     String
  source    String
  stdin     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("code_snippets")
}

// Idempotency ledger for inbound webhooks.
model ProcessedEvent {
  eventId    String   @id
  source     String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
  @@map("processed_events")
}

// ---------------------------------------------------------------- Assessment

model Assessment {
  id       String @id @default(uuid())
  courseId String
  title    String
  type     String // coding | mcq | fill_blank | descriptive
  mode     String @default("graded") // practice | graded
  maxScore Int    @default(100)

  questions Question[]

  @@index([courseId])
  @@map("assessments")
}

model Question {
  id              String  @id @default(uuid())
  assessmentId    String
  position        Int     @default(0)
  prompt          String
  // coding question fields
  stubCode        String?
  readonlyMarkers String? // JSON: {start,end}
  rubricCheckRef  String?
  hiddenTestsRef  String?
  // choice question fields
  options         String? // JSON array
  correct         String? // JSON

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("questions")
}

model Attempt {
  id           String    @id @default(uuid())
  userId       String
  assessmentId String
  startedAt    DateTime  @default(now())
  endsAt       DateTime?
  submittedAt  DateTime?
  score        Int?
  status       String    @default("in_progress") // in_progress | submitted | expired
  // JSON blobs keyed by question id: the submitted answers and their per-question
  // results. Written once and read whole, so no child rows.
  answers      String?
  results      String?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([assessmentId])
  @@index([userId])
  @@map("attempts")
}

model Submission {
  id              String   @id @default(uuid())
  attemptId       String
  codeSnapshotUrl String?
  executionTimeMs Int?
  createdAt       DateTime @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("submissions")
}

model ProctoringEvent {
  id        String   @id @default(uuid())
  attemptId String
  type      String // tab_switch | paste | blur | seb_violation
  payload   String?
  createdAt DateTime @default(now())

  @@index([attemptId])
  @@map("proctoring_events")
}

// ---------------------------------------------------------------- Hiring

model SkillPassport {
  id                 String   @id @default(uuid())
  userId             String
  tenantId           String
  verifiedBadges     Int      @default(0)
  bestContestRank    Int?
  avgLabScore        Int?
  communicationScore Int?
  updatedAt          DateTime @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("skill_passports")
}

// ---------------------------------------------------------------- Projects
// ByteXL "Nimbus" equivalent. An instructor-authored project is forked by a
// student into a durable workspace; the student submits the workspace plus
// optional links and a trainer scores it. Kept in its own tables, separate from
// lab_sessions, so the lab operator's idle sweep cannot reap a student's work.

model Project {
  id          String    @id @default(uuid())
  tenantId    String
  title       String
  description String    @default("")
  runtimeTier String    @default("tier_2_container")
  status      String    @default("draft") // draft | published | closed
  deadline    DateTime?
  maxScore    Int       @default(100)
  createdAt   DateTime  @default(now())

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  components  ProjectComponent[]
  forks       ProjectFork[]
  submissions ProjectSubmission[]

  @@index([tenantId, status])
  @@map("projects")
}

// One technology slot in a project (ByteXL's "add workspaces to the project").
// A project with N components yields up to N forks per student — a multi-service
// app is N independent workspaces wired by the student, not one stack.
model ProjectComponent {
  id                  String   @id @default(uuid())
  tenantId            String
  projectId           String
  title               String
  technology          String
  templateSlug        String?
  templateWorkspaceId String?
  position            Int      @default(0)
  createdAt           DateTime @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  forks   ProjectFork[]

  @@index([tenantId, projectId])
  @@map("project_components")
}

// A student's durable cloud workspace. Durable state (storageRef) is separate
// from running compute, so a workspace is stopped when idle without data loss.
model ProjectWorkspace {
  id             String   @id @default(uuid())
  tenantId       String
  userId         String
  templateSlug   String
  runtimeTier    String   @default("tier_2_container")
  status         String   @default("stopped") // provisioning | running | stopped | failed | archived
  ideUrl         String?
  deployUrl      String? // public URL the service is exposed on after a Deploy (E5)
  deployPort     Int? // container port the deploy exposes
  storageRef     String?
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  forks ProjectFork[]

  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("project_workspaces")
}

// A student's fork of one project component into their own durable workspace.
model ProjectFork {
  id                 String   @id @default(uuid())
  tenantId           String
  projectId          String
  componentId        String
  userId             String
  workspaceId        String
  sourceTemplateSlug String?
  sourceWorkspaceId  String?
  createdAt          DateTime @default(now())

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  component ProjectComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace ProjectWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([componentId, userId])
  @@index([tenantId, projectId])
  @@map("project_forks")
}

model ProjectSubmission {
  id          String    @id @default(uuid())
  tenantId    String
  projectId   String
  componentId String
  userId      String
  workspaceId String
  title       String
  description String    @default("")
  githubUrl   String?
  demoUrl     String?
  status      String    @default("submitted") // submitted | evaluated
  score       Int?
  feedback    String?
  submittedAt DateTime  @default(now())
  evaluatedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId])
  @@index([tenantId, userId])
  @@map("project_submissions")
}
